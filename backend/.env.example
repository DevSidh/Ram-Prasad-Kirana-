# Required API and Turso settings. Keep these server-side only.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
TURSO_REQUEST_TIMEOUT_MS=15000
# TURSO_SCHEMA_URL is only used by local schema generation against a SQLite staging copy.
TURSO_SCHEMA_URL=
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
JWT_EXPIRES_IN=7d
NODE_ENV=development
PORT=4000
GOOGLE_MAPS_ROUTES_API_KEY=
GOOGLE_MAPS_PLACES_API_KEY=
DELIVERY_SERVICE_RADIUS_KM=10

# Admin account creation and sign-in configuration.
ADMIN_NAME="Store Admin"
ADMIN_USERNAME="choose-a-unique-admin-username"
ADMIN_EMAIL="admin@example.com"
# Set ADMIN_PASSWORD locally; never commit it.

# In production, list the exact HTTPS origins allowed to call the API.
CORS_ORIGINS="http://localhost:3000,http://localhost:5000"

# Gmail API: enable Gmail API and configure OAuth with the gmail.send scope.
# Store the OAuth client secret and refresh token in your deployment host's secrets.
GMAIL_OAUTH_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GMAIL_OAUTH_CLIENT_SECRET=your-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-oauth-refresh-token
GMAIL_USER=store-mailbox@gmail.com
GMAIL_FROM="Ram Prasad General Store <store-mailbox@gmail.com>"

# Optional Firebase Cloud Messaging server credentials, kept out of source control.
# Store a single-line service-account JSON value in backend/.env or the host's secrets.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Static QR payments are manually confirmed by the cashier. No Fonepay API
# credential, dynamic QR request, or automatic payment verification is used.
