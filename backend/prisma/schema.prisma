generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                       @id @default(cuid())
  userNumber             BigInt                       @unique @default(dbgenerated("nextval('user_display_id_seq')"))
  name                   String
  email                  String                       @unique
  phone                  String?                      @unique
  avatarUrl              String?
  avatarData             Bytes?
  avatarMimeType         String?
  passwordHash           String
  role                   UserRole                     @default(CUSTOMER)
  isActive               Boolean                      @default(true)
  emailVerified          Boolean                      @default(true)
  phoneVerified          Boolean                      @default(false)
  tokenVersion           Int                          @default(0)
  isAvailable            Boolean                      @default(true)
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  addresses              Address[]
  carts                  Cart?
  deliveries             Delivery[]
  deliveryStatusChanges  DeliveryStatusHistory[]      @relation("DeliveryStatusActor")
  inventoryTransactions  InventoryTransaction[]       @relation("InventoryTransactionActor")
  notifications          Notification[]
  orders                 Order[]
  pushTokens             DeviceToken[]
  reviews                Review[]
  wishlists              Wishlist?
  buyingStreakDays       BuyingStreakPurchaseDay[]
  buyingStreakProgress   BuyingStreakRewardProgress[]
  assignedCoupons        Coupon[]                     @relation("CouponAssignedUser")
  customerRemovalRecords CustomerRemovalAudit[]       @relation("RemovedCustomer")
  customerRemovalActions CustomerRemovalAudit[]       @relation("CustomerRemovalActor")

  @@index([role])
  @@index([createdAt])
}

model BuyingStreakPurchaseDay {
  id        String   @id @default(cuid())
  userId    String
  dayKey    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayKey])
}

model BuyingStreakRewardConfig {
  id          String   @id @default(cuid())
  day         Int      @unique
  title       String
  description String
  couponId    String?
  coupon      Coupon?  @relation("StreakRewardTemplate", fields: [couponId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BuyingStreakRewardProgress {
  id               String    @id @default(cuid())
  userId           String
  day              Int
  title            String
  description      String
  couponTemplateId String?
  couponId         String?   @unique
  unlockedAt       DateTime  @default(now())
  claimedAt        DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponTemplate   Coupon?   @relation("StreakProgressTemplate", fields: [couponTemplateId], references: [id], onDelete: SetNull)
  coupon           Coupon?   @relation("StreakProgressGift", fields: [couponId], references: [id], onDelete: SetNull)

  @@unique([userId, day])
  @@index([userId, claimedAt])
}

model CustomerRemovalAudit {
  id                String   @id @default(cuid())
  customerId        String
  customerDisplayId BigInt
  removedById       String
  removedAt         DateTime @default(now())
  customer          User     @relation("RemovedCustomer", fields: [customerId], references: [id])
  removedBy         User     @relation("CustomerRemovalActor", fields: [removedById], references: [id])

  @@index([removedAt])
  @@index([customerId, removedAt])
}

model PasswordResetOtp {
  email     String   @id
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model EmailVerificationOtp {
  email     String   @id
  otpHash   String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model PendingRegistration {
  email        String   @id
  name         String
  phone        String
  passwordHash String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([expiresAt])
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  label        String?
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  district     String?
  province     String?
  postalCode   String?
  instructions String?
  latitude     Float?
  longitude    Float?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@index([userId])
}

model Category {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  description    String?
  imageUrl       String?
  isActive       Boolean         @default(true)
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  products       Product[]
  wholesaleItems WholesaleItem[]

  @@index([isActive])
  @@index([sortOrder])
}

model Product {
  id                       String                 @id @default(cuid())
  sku                      String                 @unique
  barcode                  String?                @unique
  name                     String
  slug                     String                 @unique
  categoryId               String
  brand                    String?
  price                    Decimal
  originalPrice            Decimal?
  rating                   Decimal                @default(0)
  reviewCount              Int                    @default(0)
  description              String?
  origin                   String?
  imageUrl                 String?
  imageUrls                Json                   @default("[]")
  imageData                Bytes?
  imageMimeType            String?
  normalizedImageData      Bytes?
  normalizedMimeType       String?
  unitLabel                String                 @default("1 pc")
  isWholesale              Boolean                @default(false)
  wholesalePrice           Decimal?
  wholesaleMinimumQuantity Int                    @default(1)
  lowStockThreshold        Int                    @default(10)
  isOrganic                Boolean                @default(false)
  isFeatured               Boolean                @default(false)
  isBestSeller             Boolean                @default(false)
  isVendingDrink           Boolean                @default(false)
  vendingSection           String?
  isActive                 Boolean                @default(true)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  cartItems                CartItem[]
  inventory                Inventory?
  batches                  InventoryBatch[]
  orderItems               OrderItem[]
  batchAllocations         OrderBatchAllocation[]
  category                 Category               @relation(fields: [categoryId], references: [id])
  variants                 ProductVariant[]
  reviews                  Review[]
  wishlistItems            WishlistItem[]
  coupons                  Coupon[]

  @@index([categoryId])
  @@index([isActive])
  @@index([isFeatured])
  @@index([isBestSeller])
  @@index([name])
}

model WholesaleItem {
  id                  String      @id @default(cuid())
  sku                 String      @unique
  name                String
  slug                String      @unique
  categoryId          String
  brand               String?
  price               Decimal
  stock               Int         @default(0)
  minimumQuantity     Int         @default(1)
  description         String?
  origin              String?
  imageUrl            String?
  imageData           Bytes?
  imageMimeType       String?
  normalizedImageData Bytes?
  normalizedMimeType  String?
  unitLabel           String      @default("1 pc")
  rating              Decimal     @default(0)
  reviewCount         Int         @default(0)
  isActive            Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  category            Category    @relation(fields: [categoryId], references: [id])
  cartItems           CartItem[]
  orderItems          OrderItem[]
  reviews             Review[]

  @@index([categoryId])
  @@index([isActive])
  @@index([name])
}

model StoredImage {
  id                  String   @id @default(cuid())
  imageData           Bytes
  mimeType            String
  normalizedImageData Bytes?
  normalizedMimeType  String?
  createdAt           DateTime @default(now())
}

model Inventory {
  id                    String                 @id @default(cuid())
  productId             String                 @unique
  totalStock            Int                    @default(0)
  reservedStock         Int                    @default(0)
  version               Int                    @default(0)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  product               Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryTransactions InventoryTransaction[]

  @@index([totalStock])
}

model InventoryBatch {
  id                String                 @id @default(cuid())
  productId         String
  lotNumber         String?
  manufacturedAt    DateTime?
  expiresAt         DateTime?
  noExpiry          Boolean                @default(false)
  datesVerified     Boolean                @default(false)
  receivedQuantity  Int
  remainingQuantity Int
  purchasePrice     Decimal?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  product           Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  allocations       OrderBatchAllocation[]

  @@index([productId, expiresAt])
  @@index([expiresAt])
}

model OrderBatchAllocation {
  id        String         @id @default(cuid())
  orderId   String
  productId String
  batchId   String
  quantity  Int
  createdAt DateTime       @default(now())
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch     InventoryBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([batchId])
}

model ProductVariant {
  id            String         @id @default(cuid())
  productId     String
  name          String
  sku           String         @unique
  price         Decimal?
  originalPrice Decimal?
  stock         Int            @default(0)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  cartItems     CartItem[]
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  wishlistItems WishlistItem[]

  @@index([productId])
  @@index([isActive])
}

model InventoryTransaction {
  id            String                   @id @default(cuid())
  inventoryId   String
  type          InventoryTransactionType
  quantity      Int
  balanceAfter  Int
  referenceId   String?
  notes         String?
  performedById String?
  createdAt     DateTime                 @default(now())
  inventory     Inventory                @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  performedBy   User?                    @relation("InventoryTransactionActor", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([inventoryId])
  @@index([type])
  @@index([referenceId])
  @@index([performedById])
  @@index([createdAt])
}

model Order {
  id                  String                 @id @default(cuid())
  orderNumber         String                 @unique
  userId              String
  addressId           String?
  status              OrderStatus            @default(PLACED)
  paymentMethod       PaymentMethod
  paymentStatus       PaymentStatus          @default(PENDING)
  subtotal            Decimal
  deliveryFee         Decimal                @default(0)
  discount            Decimal                @default(0)
  tip                 Decimal                @default(0)
  total               Decimal
  couponCode          String?
  idempotencyKey      String?                @unique
  scheduledDeliveryAt DateTime?
  shippingName        String
  shippingPhone       String
  shippingAddress     String
  shippingCity        String
  shippingDistrict    String?
  shippingProvince    String?
  shippingPostalCode  String?
  notes               String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  delivery            Delivery?
  address             Address?               @relation(fields: [addressId], references: [id])
  user                User                   @relation(fields: [userId], references: [id])
  items               OrderItem[]
  batchAllocations    OrderBatchAllocation[]
  statusHistory       OrderStatusHistory[]
  payments            Payment[]

  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, couponCode, status])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id              String         @id @default(cuid())
  orderId         String
  productId       String?
  wholesaleItemId String?
  productName     String
  sku             String
  quantity        Int
  weightGrams     Int?
  price           Decimal
  total           Decimal
  isWholesale     Boolean        @default(false)
  createdAt       DateTime       @default(now())
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  wholesaleItem   WholesaleItem? @relation(fields: [wholesaleItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([wholesaleItemId])
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  transactionId   String?
  amount          Decimal
  gatewayResponse Json?
  errorMessage    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([transactionId])
  @@index([status])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@index([userId])
}

model CartItem {
  id               String          @id @default(cuid())
  cartId           String
  productId        String?
  wholesaleItemId  String?
  productVariantId String?
  quantity         Int             @default(1)
  weightGrams      Int?
  unitPrice        Decimal
  isWholesale      Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  cart             Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product          Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  wholesaleItem    WholesaleItem?  @relation(fields: [wholesaleItemId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])

  @@index([cartId])
  @@index([productId])
  @@index([wholesaleItemId])
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]

  @@index([userId])
}

model WishlistItem {
  id               String          @id @default(cuid())
  wishlistId       String
  productId        String
  productVariantId String?
  createdAt        DateTime        @default(now())
  product          Product         @relation(fields: [productId], references: [id])
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])
  wishlist         Wishlist        @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId, productVariantId])
  @@index([wishlistId])
}

model Review {
  id              String         @id @default(cuid())
  productId       String?
  wholesaleItemId String?
  userId          String
  rating          Int
  text            String?
  imageUrl        String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  product         Product?       @relation(fields: [productId], references: [id], onDelete: Cascade)
  wholesaleItem   WholesaleItem? @relation(fields: [wholesaleItemId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@unique([wholesaleItemId, userId])
  @@index([productId])
  @@index([wholesaleItemId])
  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Delivery {
  id                        String                  @id @default(cuid())
  orderId                   String                  @unique
  deliveryPersonId          String?
  status                    DeliveryStatus          @default(PENDING)
  assignedAt                DateTime?
  pickedUpAt                DateTime?
  deliveredAt               DateTime?
  cashCollected             Decimal                 @default(0)
  cashCollectedAt           DateTime?
  cashHandedOver            Decimal                 @default(0)
  cashHandedOverAt          DateTime?
  latitude                  Float?
  longitude                 Float?
  locationUpdatedAt         DateTime?
  customerLatitude          Float?
  customerLongitude         Float?
  customerLocationUpdatedAt DateTime?
  notes                     String?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  deliveryPerson            User?                   @relation(fields: [deliveryPersonId], references: [id])
  order                     Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  statusHistory             DeliveryStatusHistory[]

  @@index([deliveryPersonId])
  @@index([status])
  @@index([deliveryPersonId, status, assignedAt])
}

model DeliveryStatusHistory {
  id          String         @id @default(cuid())
  deliveryId  String
  changedById String
  status      DeliveryStatus
  note        String?
  createdAt   DateTime       @default(now())
  delivery    Delivery       @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  changedBy   User           @relation("DeliveryStatusActor", fields: [changedById], references: [id])

  @@index([deliveryId])
  @@index([changedById])
  @@index([createdAt])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Coupon {
  id                      String                       @id @default(cuid())
  code                    String                       @unique
  productId               String?
  assignedUserId          String?
  discountType            DiscountType                 @default(PERCENTAGE)
  discountPercent         Decimal?
  discountAmount          Decimal?
  minOrderAmount          Decimal                      @default(0)
  maxDiscount             Decimal?
  usageLimit              Int?
  perUserLimit            Int?
  usedCount               Int                          @default(0)
  isActive                Boolean                      @default(true)
  isDeleted               Boolean                      @default(false)
  isAnnounced             Boolean                      @default(false)
  expiresAt               DateTime?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  product                 Product?                     @relation(fields: [productId], references: [id], onDelete: Restrict)
  assignedUser            User?                        @relation("CouponAssignedUser", fields: [assignedUserId], references: [id], onDelete: Cascade)
  streakRewardConfigs     BuyingStreakRewardConfig[]   @relation("StreakRewardTemplate")
  streakProgressTemplates BuyingStreakRewardProgress[] @relation("StreakProgressTemplate")
  streakProgressGift      BuyingStreakRewardProgress?  @relation("StreakProgressGift")

  @@index([isActive])
  @@index([expiresAt])
  @@index([productId])
  @@index([assignedUserId])
}

model StoreSetting {
  id                   String   @id @default("store")
  isOrderingEnabled    Boolean  @default(true)
  weeklyHours          Json
  customerMenuFeatures Json     @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

enum UserRole {
  CUSTOMER
  ADMIN
  DELIVERY_PERSON
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PROCESSING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  ESEWA
  KHALTI
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum InventoryTransactionType {
  RESERVED
  PURCHASED
  RELEASED
  RESTOCKED
  ADJUSTED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  ACCEPTED
  DECLINED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELLED
}

enum NotificationType {
  ORDER_PLACED
  ORDER_CONFIRMED
  ORDER_PROCESSING
  ORDER_OUT_FOR_DELIVERY
  ORDER_DELIVERED
  ORDER_CANCELLED
  DELIVERY_ASSIGNED
  DELIVERY_UPDATED
  PROMOTIONAL
}

enum crdb_internal_region {
  aws_ap_south_1 @map("aws-ap-south-1")
}
