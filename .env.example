# Backend API & Server Configuration
PORT=4000
NODE_ENV=development
API_BASE_URL="http://localhost:4000/api/v1"
CORS_ORIGINS="https://YOUR-WEB-APP-HOST"

# Database Configuration (CockroachDB)
DATABASE_URL="postgresql://store_app:8evzNwzpqju2ZH5PROguFw@ram-prasad-store-35014.j77.aws-ap-south-1.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full"

# Authentication & JWT
AUTH_SECRET="replace-with-a-secure-random-string-of-at-least-32-characters"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_EXPIRES_IN="30d"
ADMIN_NAME="Ram Prasad Store Admin"
ADMIN_USERNAME="choose-a-unique-admin-username"
ADMIN_EMAIL="admin@example.com"
# Set ADMIN_PASSWORD locally; never commit or share it.

# Google Authentication
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Firebase Cloud Messaging & Push Notifications
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_YOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Cloud Storage (AWS S3 / GCP Storage / Cloudflare R2)
STORAGE_BUCKET="ram-prasad-store-assets"
STORAGE_REGION="ap-south-1"
STORAGE_ACCESS_KEY="YOUR_STORAGE_ACCESS_KEY"
STORAGE_SECRET_KEY="YOUR_STORAGE_SECRET_KEY"

# Payment Gateways (Nepal eSewa & Khalti & COD)
ESEWA_MERCHANT_CODE="EPAYTEST"
ESEWA_SECRET_KEY="REPLACE_WITH_ESEWA_SECRET_KEY"
ESEWA_VERIFY_URL="https://uat.esewa.com.np/epay/transrec"

KHALTI_PUBLIC_KEY="test_public_key_dc74e0fd57cb46cd93832aee0a505a4f"
KHALTI_SECRET_KEY="replace_with_khalti_secret_key"
KHALTI_VERIFY_URL="https://khalti.com/api/v2/payment/verify/"

# Transaction Concurrency & Rate Limiting
REDIS_URL="redis://localhost:6379"
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Gmail SMTP (use a Google App Password, never your regular Gmail password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="ramprasad.faststore@gmail.com"
SMTP_PASS=YOUR_GOOGLE_APP_PASSWORD
SMTP_FROM="Ram Prasad General Store <ramprasad.faststore@gmail.com>"
